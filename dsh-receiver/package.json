{
  "name": "dsh-gpt-receiver",
  "version": "0.2.0",
  "type": "module",
  "description": "接收 GPT 实施方案，在 DSH 桌面创建开发会话并回传结果",
  "main": "./lib/index.mjs",
  "exports": { ".": "./lib/index.mjs", "./client": "./lib/client.js" },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-connection"] }
  }
}
